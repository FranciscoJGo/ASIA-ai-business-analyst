# --- CONFIGURACIÓN DE MODELOS (MODEL ROUTER) ---
# Opciones: "local" (Hugging Face via Ollama) o "cloud" (API externa)
DEFAULT_MODEL_MODE=cloud

# Configuración Local (Ollama ejecutando modelo open-weight de Hugging Face)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_NAME=hf.co/Qwen/Qwen2.5-7B-Instruct-GGUF

# Configuración Nube (API externa compatible con OpenAI SDK, ej. Gemini o OpenAI)
CLOUD_API_KEY=pega_aqui_tu_api_key
CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CLOUD_MODEL_NAME=gemini-2.5-flash

# --- EMBEDDINGS LOCALES (HUGGING FACE) ---
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small

# --- OBSERVABILIDAD (LANGFUSE) ---
LANGFUSE_PUBLIC_KEY=pk-lf-pega_aqui
LANGFUSE_SECRET_KEY=sk-lf-pega_aqui
LANGFUSE_HOST=https://cloud.langfuse.com